<Project>
  <PropertyGroup>
    <NativePackagePlatform Condition="'$(NativePackagePlatform)' == ''">All</NativePackagePlatform>
    <ThirdPartyLicenseRoot>$(MSBuildThisFileDirectory)..\..\SDL3-CS.NativePackages\ThirdPartyLicenses</ThirdPartyLicenseRoot>
    <ThirdPartySourceRoot>$(MSBuildThisFileDirectory)..\..\SDL3-CS.NativePackages\ThirdPartySources</ThirdPartySourceRoot>
    <NativeReceiptRoot Condition="'$(NativeReceiptRoot)' == ''">$(MSBuildThisFileDirectory)..\..\artifacts\release\receipts</NativeReceiptRoot>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(ThirdPartyLicenseRoot)\README.md" Pack="true" PackagePath="licenses\README.md" />
  </ItemGroup>

  <ItemGroup Condition="'$(PackageId)' == 'SDL3-CS.$(NativePackagePlatform)'">
    <None Include="$(ThirdPartyLicenseRoot)\SDL\*" Pack="true" PackagePath="licenses\SDL" />
  </ItemGroup>
  <ItemGroup Condition="'$(PackageId)' == 'SDL3-CS.$(NativePackagePlatform).Image'">
    <None Include="$(ThirdPartyLicenseRoot)\Image\*" Pack="true" PackagePath="licenses\Image" />
    <None Include="$(ThirdPartyLicenseRoot)\libwebp\COPYING" Pack="true" PackagePath="licenses\libwebp" />
  </ItemGroup>
  <ItemGroup Condition="'$(PackageId)' == 'SDL3-CS.$(NativePackagePlatform).Mixer'">
    <None Include="$(ThirdPartyLicenseRoot)\Mixer\*" Pack="true" PackagePath="licenses\Mixer" />
    <None Include="$(ThirdPartySourceRoot)\README.md;$(ThirdPartySourceRoot)\SOURCE_MANIFEST.json;$(ThirdPartySourceRoot)\game-music-emu-*.tar.gz;$(ThirdPartySourceRoot)\mpg123-*.tar.gz" Pack="true" PackagePath="licenses\sources" />
    <None Include="$(NativeReceiptRoot)\SDL_mixer\*.json" Pack="true" PackagePath="licenses\provenance" />
  </ItemGroup>
  <ItemGroup Condition="'$(PackageId)' == 'SDL3-CS.$(NativePackagePlatform).TTF'">
    <None Include="$(ThirdPartyLicenseRoot)\TTF\*" Pack="true" PackagePath="licenses\TTF" />
  </ItemGroup>
  <ItemGroup Condition="'$(PackageId)' == 'SDL3-CS.$(NativePackagePlatform).Shadercross'">
    <None Include="$(ThirdPartyLicenseRoot)\Shadercross\*" Pack="true" PackagePath="licenses\Shadercross" />
  </ItemGroup>
  <ItemGroup Condition="'$(PackageId)' == 'SDL3-CS.$(NativePackagePlatform).Shadercross' and ('$(NativePackagePlatform)' == 'Linux' or '$(NativePackagePlatform)' == 'MacOS')">
    <None Include="$(ThirdPartyLicenseRoot)\ShadercrossVkd3d\*" Pack="true" PackagePath="licenses\ShadercrossVkd3d" />
    <None Include="$(ThirdPartySourceRoot)\README.md;$(ThirdPartySourceRoot)\SOURCE_MANIFEST.json;$(ThirdPartySourceRoot)\vkd3d-2.0.tar.xz" Pack="true" PackagePath="licenses\sources" />
    <None Include="$(NativeReceiptRoot)\SDL_shadercross\*.json" Pack="true" PackagePath="licenses\provenance" />
  </ItemGroup>

  <ItemGroup Condition="'$(NativePackagePlatform)' == 'All' or '$(NativePackagePlatform)' == 'Windows'">
    <None Include="$(MSBuildProjectDirectory)\lib\win-x86\**\*" Pack="true" PackagePath="runtimes\win-x86\native\%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="$(MSBuildProjectDirectory)\lib\win-x64\**\*" Pack="true" PackagePath="runtimes\win-x64\native\%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="$(MSBuildProjectDirectory)\lib\win-arm64\**\*" Pack="true" PackagePath="runtimes\win-arm64\native\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup Condition="'$(NativePackagePlatform)' == 'All' or '$(NativePackagePlatform)' == 'Linux'">
    <None Include="$(MSBuildProjectDirectory)\lib\linux-x64\**\*" Pack="true" PackagePath="runtimes\linux-x64\native\%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="$(MSBuildProjectDirectory)\lib\linux-arm64\**\*" Pack="true" PackagePath="runtimes\linux-arm64\native\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup Condition="'$(NativePackagePlatform)' == 'All' or '$(NativePackagePlatform)' == 'MacOS'">
    <None Include="$(MSBuildProjectDirectory)\lib\osx-x64\**\*" Pack="true" PackagePath="runtimes\osx-x64\native\%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="$(MSBuildProjectDirectory)\lib\osx-arm64\**\*" Pack="true" PackagePath="runtimes\osx-arm64\native\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup Condition="'$(NativePackagePlatform)' == 'All' or '$(NativePackagePlatform)' == 'Android'">
    <None Include="$(MSBuildProjectDirectory)\lib\android-arm\**\*" Pack="true" PackagePath="runtimes\android-arm\native\%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="$(MSBuildProjectDirectory)\lib\android-arm64\**\*" Pack="true" PackagePath="runtimes\android-arm64\native\%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="$(MSBuildProjectDirectory)\lib\android-x86\**\*" Pack="true" PackagePath="runtimes\android-x86\native\%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="$(MSBuildProjectDirectory)\lib\android-x64\**\*" Pack="true" PackagePath="runtimes\android-x64\native\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup Condition="'$(NativePackagePlatform)' == 'All' or '$(NativePackagePlatform)' == 'iOS'">
    <None Include="$(MSBuildProjectDirectory)\lib\ios-arm64\**\*" Pack="true" PackagePath="runtimes\ios-arm64\native\%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="$(MSBuildProjectDirectory)\lib\iossimulator-arm64\**\*" Pack="true" PackagePath="runtimes\iossimulator-arm64\native\%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="$(MSBuildProjectDirectory)\lib\iossimulator-x64\**\*" Pack="true" PackagePath="runtimes\iossimulator-x64\native\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup Condition="'$(NativePackagePlatform)' == 'All' or '$(NativePackagePlatform)' == 'tvOS'">
    <None Include="$(MSBuildProjectDirectory)\lib\tvos-arm64\**\*" Pack="true" PackagePath="runtimes\tvos-arm64\native\%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="$(MSBuildProjectDirectory)\lib\tvossimulator-arm64\**\*" Pack="true" PackagePath="runtimes\tvossimulator-arm64\native\%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="$(MSBuildProjectDirectory)\lib\tvossimulator-x64\**\*" Pack="true" PackagePath="runtimes\tvossimulator-x64\native\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
